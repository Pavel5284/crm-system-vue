# Local:
# NUXT_PUBLIC_API_BASE_URL=/api
# Prod Render:
NUXT_PUBLIC_API_BASE_URL=https://crm-api-gateway-zyrg.onrender.com/api

# --- Микрофронтенды (вариант B, пилот customers) ---
# Режим: local (без федерации) | remote (только remote + экран ошибки) | auto (remote с фолбэком на local)
NUXT_PUBLIC_MFE_CUSTOMERS=auto
# Dev: NUXT_PUBLIC_MFE_CUSTOMERS_REMOTE_URL=http://localhost:4174/remoteEntry.js
# Prod: ВЕРСИОНИРОВАННЫЙ URL, не latest/алиас, напр.:
# NUXT_PUBLIC_MFE_CUSTOMERS_REMOTE_URL=https://customers-remote-<hash>.vercel.app/remoteEntry.js
NUXT_PUBLIC_MFE_CUSTOMERS_REMOTE_URL=http://localhost:4174/remoteEntry.js

# --- CAPTCHA (Cloudflare Turnstile, виджет на /register) ---
# Site Key из той же пары, что TURNSTILE_SECRET_KEY на бэкенде.
# Без ключа виджет не рендерится (dev).
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
